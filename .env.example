# copy to .env (don't commit .env)
# The app uses LOCAL_* on localhost and LIVE_* everywhere else.
# Uncomment to force one: APP_ENV=local or APP_ENV=live
# APP_ENV=

# --- local XAMPP ---
# leave the URL empty to auto-detect
LOCAL_APP_URL=
LOCAL_APP_DEBUG=true
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3307
LOCAL_DB_NAME=idlewheels
LOCAL_DB_USER=root
LOCAL_DB_PASS=

# --- live server ---
LIVE_APP_URL=
LIVE_APP_DEBUG=false
LIVE_DB_HOST=localhost
LIVE_DB_PORT=3306
LIVE_DB_NAME=
LIVE_DB_USER=
LIVE_DB_PASS=

# paystack keys (test keys while testing)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

MAIL_ADMIN_EMAIL=
MAIL_FROM=no-reply@idlewheels.local
