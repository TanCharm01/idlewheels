# send everything to index.php
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(app|config|database|storage|tools|vendor)(/|$) - [F,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "\.(sql|md|lock|json|example|sh)$">
  Require all denied
</FilesMatch>

# block .env and other dotfiles
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
